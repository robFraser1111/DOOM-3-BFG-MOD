<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Late overrides so VS2022 defaults do not flip this 2012 codebase onto
    C++17 (which removes std::auto_ptr and the register keyword) or /permissive-.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <ConformanceMode>false</ConformanceMode>
      <LanguageStandard>stdcpp14</LanguageStandard>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <SpectreMitigation>false</SpectreMitigation>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!--
        4311, 4312 and 4302 (pointer truncated to a 32-bit int, or a 32-bit int
        widened back to a pointer) are left enabled. TreatWarningAsError is on,
        so a new cast of that shape fails the x64 build.
        4244 and 4267 stay disabled: this 2012 tree converts float to int and
        size_t to int in thousands of places that are not pointer-width bugs.
        4477 (printf format) and 4838 (narrowing) stay disabled for the same reason.
        Those four were reviewed in the x64 audit; the pointer bugs were fixed in code.
      -->
      <DisableSpecificWarnings>4456;4457;4458;4459;4244;4267;4826;4838;5033;5038;4365;4577;4624;5026;5027;5204;5205;5220;5262;5264;4464;4866;4467;4595;5208;5246;26812;26495;6285;6385;6386;28159;28182;26451;26819;5267;5266;4324;4530;4571;4018;4389;4245;4101;4189;4701;4702;4706;4505;4242;4310;4800;4828;5045;5219;5240;5243;5245;5249;5286;5287;4473;4474;4477;4499;4644;4668;4774;4777;4840;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
